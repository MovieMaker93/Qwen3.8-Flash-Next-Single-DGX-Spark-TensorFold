+def read_ahead(w: Weights, st: State, tokens: Sequence[int], ahead: Sequence[int]) -> None:
+    """Start reading the n-gram rows a later ``stage`` of ``ahead`` looks up once ``tokens`` are committed (tables that read ahead)."""
+
+    if st.ple_history is None or not len(ahead) or getattr(w, "x3", None) is not None:
+        return
+    history = np.concatenate([st.ple_history, np.asarray(tokens, dtype=np.int64)])[-(w.cfg.ngram_size - 1):]   # as commit leaves it
+    toks = np.asarray(ahead, dtype=np.int64)
+    for layer in w.layers:
+        p = layer.ple
+        start = getattr(p.table, "read_ahead", None) if p is not None else None
+        if start is not None:
+            start(p.ngram.ids(history, toks))
+
+
